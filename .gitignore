# Datos locales — NUNCA se versionan (sitios y clientes reales)
registry/sites.json
registry/marca-informes.txt
sites/*
!sites/_template/
state.md

# Config local de herramientas
.claude/settings.local.json
.cursor/mcp.json
kilo.jsonc
.kilo/

# Capa personal del operador: vive solo en la copia instalada, nunca en el kit compartido.
# Las skills/subagentes personales se listan en .sync-keep.local, que la sync preserva.
.sync-keep.local

# Sistema
.DS_Store
__pycache__/
*.pyc
# Komandesk Agent Kit local secrets
.komandesk/secrets.local.env
.komandesk/credentials.local.json
.komandesk/*.secret
.komandesk/*.secret.*
.komandesk/*.bak
.komandesk/*.tmp

# migraciones exportadas (generadas, pesadas)
exports/

# Instalacion local de Komandesk: como el workspace de SA sigue este kit como
# proyecto. No le sirve a nadie que clone, y publica la URL interna del OPS.
.komandesk/
docs/komandesk-agent-kit.md
